# Développement : base locale (fichier) — aucune variable requise.
# Production (Render) : base Turso distante.
DATABASE_URL=libsql://delegpharma-<org>.turso.io
TURSO_AUTH_TOKEN=

# Secret JWT (générer un long aléatoire, ex: openssl rand -hex 32)
JWT_SECRET=change-me-please

# Port (Render injecte PORT)
PORT=10000

# Cookie
COOKIE_SECURE=true
