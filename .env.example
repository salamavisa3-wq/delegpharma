# Développement : base locale (fichier SQLite data/delegpharma.db) — aucune variable requise.
# Production (Render) : base Postgres distante (Render Postgres), URL fournie par le blueprint.
DATABASE_URL=postgresql://user:password@host:5432/delegpharma

# Secret JWT (générer un long aléatoire, ex: openssl rand -hex 32)
JWT_SECRET=change-me-please

# Port (Render injecte PORT)
PORT=10000

# Cookie
COOKIE_SECURE=true
