# ── DelegPharma — configuration ───────────────────────────────────────────────
# Copier vers .env (dev) ou placer sur le VPS de production (hors git).
# Dev local : base SQLite (data/delegpharma.db) — DATABASE_URL optionnelle.

# Base de données. Absente en dev → SQLite (node:sqlite).
# Production (VPS) : PostgreSQL 16, base `delegpharma`.
DATABASE_URL=postgresql://delegpharma:CHANGE_ME@127.0.0.1:5432/delegpharma

# Secret JWT — long aléatoire : openssl rand -hex 32
JWT_SECRET=change-me-please

# Port HTTP (nginx reverse-proxy vers 127.0.0.1:10000)
PORT=10000

# Cookie d'authentification
#   dev : false (http)   prod : true (https uniquement)
COOKIE_SECURE=false

# ── Paiement CinetPay (monétisation §3) ───────────────────────────────────────
# PAY_MODE=demo    → paiement simulé ; activation manuelle par admin/labo/plateforme
#                    (POST /api/abonnements/demo-confirmer avec la reference).
# PAY_MODE=cinetpay → agrégateur réel/sandbox : CINETPAY_APIKEY + CINETPAY_SITE_ID requis.
# En mode cinetpay, l'adapter envoie channels='ALL' → la page CinetPay propose
# Mobile Money (Wave, Orange Money, Free) ET carte Visa/Mastercard (3DS). Les
# champs customer_* (adresse/ville/pays) sont obligatoires pour le paiement carte
# (erreur 608 sinon) — ils sont saisis à l'inscription (optionnels) et stockés sur users.
PAY_MODE=demo

# Clés marchand CinetPay (dashboard marchand — jamais côté client, VPS uniquement).
CINETPAY_APIKEY=
CINETPAY_SITE_ID=

# ── Paiement PayPal (Orders API v2, EUR) ──────────────────────────────────────
# PAY_MODE=paypal → PayPal. PayPal ne supporte pas le XOF : les montants FCFA sont
# convertis en EUR au taux fixe UEMOA 655,957 (5 000 FCFA ≈ 7,62 €).
# Clés : developer.paypal.com → Apps & Credentials → REST API (Client ID + Secret).
# PAYPAL_SANDBOX=true (défaut) → api-m.sandbox.paypal.com ; false → api-m.paypal.com.
# Le client choisit son moyen (cinetpay|paypal) dans la vue Abonnement ; en mode
# demo tout passe par demo (aucun appel réseau).
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_SANDBOX=true

# URL publique de l'API — sert à construire notify_url/return_url du paiement CinetPay.
#   dev : http://localhost:10000      prod : https://app.delegpharma.com
APP_BASE_URL=http://localhost:10000

# ── Assistant IA (Ollama Cloud) ──────────────────────────────────────────────
# Clé serveur UNIQUEMENT (jamais côté client — elle serait extractible par DevTools).
# Modèle par défaut : nemotron-3-nano:30b (repli dhiltgen/nemotron-3-nano:30b si 404).
OLLAMA_API_KEY=
OLLAMA_MODEL=nemotron-3-nano:30b

# ── Identité légale / contact (pages /contact, /mentions-legales, /politique-de-confidentialite) ──
# Tant que ces variables sont vides, ces pages affichent un texte de repli honnête au lieu
# d'un marqueur "[à compléter]" — mais /mentions-legales reste légalement incomplète sans
# LEGAL_ENTITY_NAME / LEGAL_ADDRESS / LEGAL_DIRECTOR_NAME. À renseigner avant mise en prod
# réelle (obligatoire pour un site encaissant des paiements — CinetPay/PayPal).
SUPPORT_EMAIL=
SUPPORT_WHATSAPP=
LEGAL_ENTITY_NAME=
LEGAL_ADDRESS=
# Registre de Commerce et NINEA (Sénégal) — affichés dans l'Éditeur si renseignés.
LEGAL_RC=
LEGAL_NINEA=
LEGAL_DIRECTOR_NAME=
# DPO_EMAIL retombe sur SUPPORT_EMAIL si absent.
DPO_EMAIL=
# Ex. "24 mois à compter de la résiliation" — sinon formule générique par défaut.
DATA_RETENTION_NOTE=

# ── Production (VPS OVHcloud) ─────────────────────────────────────────────────
# NODE_ENV=production
# COOKIE_SECURE=true
# PAY_MODE=cinetpay
