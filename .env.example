# ── DelegPharma — configuration ───────────────────────────────────────────────
# Copier vers .env (dev) ou placer sur le VPS de production (hors git).
# Dev local : base SQLite (data/delegpharma.db) — DATABASE_URL optionnelle.

# Base de données. Absente en dev → SQLite (node:sqlite).
# Production (VPS) : PostgreSQL 16, base `delegpharma`.
DATABASE_URL=postgresql://delegpharma:CHANGE_ME@127.0.0.1:5432/delegpharma

# Secret JWT — long aléatoire : openssl rand -hex 32
JWT_SECRET=change-me-please

# Port HTTP (nginx reverse-proxy vers 127.0.0.1:10000)
PORT=10000

# Cookie d'authentification
#   dev : false (http)   prod : true (https uniquement)
COOKIE_SECURE=false

# ── Paiement CinetPay (monétisation §3) ───────────────────────────────────────
# PAY_MODE=demo    → paiement simulé ; activation manuelle par admin/labo/plateforme
#                    (POST /api/abonnements/demo-confirmer avec la reference).
# PAY_MODE=cinetpay → agrégateur réel/sandbox : CINETPAY_APIKEY + CINETPAY_SITE_ID requis.
# En mode cinetpay, l'adapter envoie channels='ALL' → la page CinetPay propose
# Mobile Money (Wave, Orange Money, Free) ET carte Visa/Mastercard (3DS). Les
# champs customer_* (adresse/ville/pays) sont obligatoires pour le paiement carte
# (erreur 608 sinon) — ils sont saisis à l'inscription (optionnels) et stockés sur users.
PAY_MODE=demo

# Clés marchand CinetPay (dashboard marchand — jamais côté client, VPS uniquement).
CINETPAY_APIKEY=
CINETPAY_SITE_ID=

# URL publique de l'API — sert à construire notify_url/return_url du paiement CinetPay.
#   dev : http://localhost:10000      prod : https://app.delegpharma.com
APP_BASE_URL=http://localhost:10000

# ── Production (VPS OVHcloud) ─────────────────────────────────────────────────
# NODE_ENV=production
# COOKIE_SECURE=true
# PAY_MODE=cinetpay
